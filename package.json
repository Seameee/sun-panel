{
  "name": "sun-panel",
  "version": "0.0.0",
  "private": false,
  "description": "Sun-Panel Web",
  "author": "BraisedHunter <95302870@qq.com>",
  "keywords": [
    "Sun-Panel",
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p add-version type-check build-only",
    "add-version": "node ./add-frontend-version.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "pnpm install && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "common:prepare": "husky install"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "13.9.0",
    "axios": "1.21.1",
    "crypto-js": "4.2.0",
    "dompurify": "3.4.18",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.2",
    "markdown-it": "15.0.3",
    "moment": "2.31.0",
    "naive-ui": "2.45.3",
    "pinia": "2.3.1",
    "uqr": "0.1.3",
    "vue": "3.5.46",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.23",
    "vue-router": "4.6.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@iconify/vue": "^4.1.0",
    "@types/crypto-js": "^4.1.1",
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.35.0",
    "less": "^4.1.3",
    "lint-staged": "^13.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "rimraf": "^4.2.0",
    "tailwindcss": "^3.2.7",
    "terser": "5.51.4",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vue-tsc": "3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "pnpm lint:fix"
    ]
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@traptitech/markdown-it-katex>katex": "0.18.2"
    }
  }
}
